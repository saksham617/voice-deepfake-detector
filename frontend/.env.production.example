# Production environment configuration.
# Copy to `.env.production` (or set these as env vars in your hosting
# platform's build settings) before running `npm run build`.
#
# Vite bakes these into the static bundle at BUILD time -- there is no
# runtime config for a static SPA, so this must be set before building,
# not after deploying.

# Public URL of the deployed FastAPI backend.
VITE_API_BASE_URL=https://your-backend-host.example.com

# Must be false to call the real backend instead of the mock.
VITE_USE_MOCK=false
