# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Environment / secrets ----
.env
.env.*
*.pem
*.key

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Testing / coverage ----
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---- Type checkers / linters ----
.mypy_cache/
.ruff_cache/

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- IDE ----
.vscode/
.idea/

# ---- ML models / weights ----
*.pt
*.pth
*.h5
*.hdf5
*.ckpt
*.onnx
*.pkl
*.joblib
models/*
!models/.gitkeep

# SpeechBrain's local cache of pretrained model downloads (weights, plus
# small yaml/txt config files not caught by the patterns above) -- fetched
# fresh from Hugging Face Hub on first load, never committed.
pretrained_models/

# Live-call AASIST checkpoint dir: everything ignored except the checkpoint
# itself, which IS committed on purpose (see the Deployment section below)
# via Git LFS -- too large (~1.26GB) for a normal git blob.
backend/models/*
!backend/models/.gitkeep

# wav2vec2/IndicWav2Vec SSL frontend caches used by the live-call feature
# extractor (backend/inference/feature_extractor.py) -- fetched fresh, never
# committed.
s3prl_hub/
hf_cache/

# ---- Datasets / audio ----
data/raw/*
data/processed/*
data/generated/*
data/manifests/*
data/eval_scores.tsv
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/generated/.gitkeep
!data/manifests/.gitkeep
!data/raw/asvspoof2019/
data/raw/asvspoof2019/*
!data/raw/asvspoof2019/.gitkeep
*.wav
*.mp3
*.flac
*.ogg
!tests/fixtures/*.wav
scratch/

# ---- Logs ----
*.log
logs/

# ---- Local databases ----
# reports.db (src/models/reporting.py) is per-machine runtime data, not a
# project asset -- same reasoning as the *.pt model-weight exclusions above.
*.db
*.sqlite
*.sqlite3

# ---- Node / frontend ----
node_modules/
frontend/build/
frontend/dist/

# ---- Deployment: trained model checkpoints are committed on purpose ----
# Everything else under data/processed/, backend/models/, and *.pt stays
# ignored (see above); these are narrow, explicit exceptions so a fresh
# clone/deploy has both models without needing external storage.
# cnn_baseline.pt: ~13MB, well under GitHub's limits, committed as a normal blob.
!data/processed/models/
!data/processed/models/cnn_baseline.pt
# aasist_indicw2v.pt: ~1.26GB, tracked via Git LFS (see .gitattributes).
!backend/models/aasist_indicw2v.pt
.vercel
.env*
