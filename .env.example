# VoiceGuard live-call (Twilio) configuration — copy to .env and fill in.
# .env is gitignored (see .gitignore ".env*"). NEVER commit real credentials.

# --- Twilio account (Console > Account Info) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Twilio Verify service (Console > Verify > Services > create one) ---
TWILIO_VERIFY_SERVICE_SID=

# --- The provisioned Twilio phone number callers dial for the demo (E.164) ---
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- Public HTTPS URL of THIS backend, e.g. an ngrok tunnel ---
# Used to build the wss:// Media Stream URL in the voice webhook's TwiML, and it's where you
# point the number's "A CALL COMES IN" webhook: <PUBLIC_BASE_URL>/twilio/voice
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- OTP mode ---
# true  = dev-mock: no real SMS, the code below is always accepted (safe for demos, and
#         sidesteps India's DLT/sender-ID SMS restrictions on +91 numbers).
# false = real Twilio Verify SMS (requires the credentials above + India SMS setup on the account).
TELEPHONY_DEV_MODE=true
TELEPHONY_DEV_CODE=123456

# --- Inference backend for the live-call analyzer ---
# stub = random/heuristic verdicts in {is_fake, confidence} shape (default; no model needed).
# real = the trained AASIST pipeline (swap in later — see backend/inference/live_infer.py).
VG_LIVE_INFERENCE=stub
