# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Environment / secrets ----
.env
.env.*
*.pem
*.key

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Testing / coverage ----
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---- Type checkers / linters ----
.mypy_cache/
.ruff_cache/

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- IDE ----
.vscode/
.idea/

# ---- ML models / weights ----
*.pt
*.pth
*.h5
*.hdf5
*.ckpt
*.onnx
*.pkl
*.joblib
models/*
!models/.gitkeep

# SpeechBrain's local cache of pretrained model downloads (weights, plus
# small yaml/txt config files not caught by the patterns above) -- fetched
# fresh from Hugging Face Hub on first load, never committed.
pretrained_models/

# ---- Datasets / audio ----
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/asvspoof2019/
data/raw/asvspoof2019/*
!data/raw/asvspoof2019/.gitkeep
*.wav
*.mp3
*.flac
*.ogg

# ---- Logs ----
*.log
logs/

# ---- Local databases ----
# reports.db (src/models/reporting.py) is per-machine runtime data, not a
# project asset -- same reasoning as the *.pt model-weight exclusions above.
*.db
*.sqlite
*.sqlite3

# ---- Node / frontend ----
node_modules/
frontend/build/
frontend/dist/

# ---- Deployment: trained CNN checkpoint is committed on purpose ----
# Everything else under data/processed/ and *.pt stays ignored (see above);
# this is a narrow, explicit exception so a fresh clone/deploy has the model
# without needing external storage. ~13MB, well under GitHub's limits.
!data/processed/models/
!data/processed/models/cnn_baseline.pt
.vercel
.env*
